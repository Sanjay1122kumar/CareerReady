# Copy to .env for local testing with `netlify dev`.
# On the live site set the same names in Netlify: Site configuration > Environment variables.
ADMIN_USER=your-admin-username
ADMIN_PASSWORD=use-a-long-random-password
# Any long random string, e.g. output of: openssl rand -hex 32
ADMIN_SECRET=replace-with-a-long-random-string
